{
  "description": "Two overlapping blocks joined into one body, then intersected with a third.",
  "calls": [
    {
      "tool": "create_sketch",
      "arguments": {
        "plane": "XY"
      }
    },
    {
      "tool": "sketch_ops",
      "arguments": {
        "sketch": "$0",
        "ops": [
          {
            "op": "rectangle",
            "a": [
              0,
              0
            ],
            "b": [
              10,
              10
            ]
          }
        ]
      }
    },
    {
      "tool": "extrude",
      "arguments": {
        "regions": "all",
        "sketch": "$0",
        "distance": 5
      }
    },
    {
      "tool": "create_sketch",
      "arguments": {
        "plane": "XY"
      }
    },
    {
      "tool": "sketch_ops",
      "arguments": {
        "sketch": "$3",
        "ops": [
          {
            "op": "rectangle",
            "a": [
              5,
              5
            ],
            "b": [
              15,
              15
            ]
          }
        ]
      }
    },
    {
      "tool": "extrude",
      "arguments": {
        "regions": "all",
        "sketch": "$3",
        "distance": 5,
        "operation": "join",
        "targets": [
          "$2.body"
        ]
      }
    },
    {
      "tool": "create_sketch",
      "arguments": {
        "plane": "XY"
      }
    },
    {
      "tool": "sketch_ops",
      "arguments": {
        "sketch": "$6",
        "ops": [
          {
            "op": "rectangle",
            "a": [
              0,
              0
            ],
            "b": [
              12,
              12
            ]
          }
        ]
      }
    },
    {
      "tool": "extrude",
      "arguments": {
        "regions": "all",
        "sketch": "$6",
        "distance": 5,
        "operation": "intersect",
        "targets": [
          "$2.body"
        ]
      }
    }
  ],
  "expect": {
    "ok": true,
    "bodies": {
      "$2": {
        "volume": 620,
        "volume_tol": 1e-06,
        "closed": true,
        "aabb": [
          [
            0,
            0,
            0
          ],
          [
            12,
            12,
            5
          ]
        ]
      }
    }
  }
}