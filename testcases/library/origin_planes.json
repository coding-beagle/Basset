{
  "description": "The same rectangle on each origin plane extrudes along that plane's normal: YZ along +x, XZ along +y.",
  "calls": [
    {
      "tool": "create_sketch",
      "arguments": {
        "plane": "YZ"
      }
    },
    {
      "tool": "sketch_ops",
      "arguments": {
        "sketch": "$0",
        "ops": [
          {
            "op": "rectangle",
            "a": [
              0,
              0
            ],
            "b": [
              10,
              5
            ]
          }
        ]
      }
    },
    {
      "tool": "extrude",
      "arguments": {
        "regions": "all",
        "sketch": "$0",
        "distance": 4
      }
    },
    {
      "tool": "create_sketch",
      "arguments": {
        "plane": "XZ"
      }
    },
    {
      "tool": "sketch_ops",
      "arguments": {
        "sketch": "$3",
        "ops": [
          {
            "op": "rectangle",
            "a": [
              0,
              0
            ],
            "b": [
              10,
              5
            ]
          }
        ]
      }
    },
    {
      "tool": "extrude",
      "arguments": {
        "regions": "all",
        "sketch": "$3",
        "distance": 4
      }
    }
  ],
  "expect": {
    "ok": true,
    "bodies": {
      "$2": {
        "volume": 200,
        "volume_tol": 1e-09,
        "closed": true,
        "aabb": [
          [
            0,
            0,
            0
          ],
          [
            4,
            10,
            5
          ]
        ]
      },
      "$5": {
        "volume": 200,
        "volume_tol": 1e-09,
        "closed": true,
        "aabb": [
          [
            0,
            0,
            0
          ],
          [
            5,
            4,
            10
          ]
        ]
      }
    }
  }
}