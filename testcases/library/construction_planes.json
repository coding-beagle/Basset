{
  "description": "A circle on an offset plane extruded back towards the origin, and a square on a plane turned 45\u00b0 about x.",
  "calls": [
    {
      "tool": "offset_plane",
      "arguments": {
        "base": "XY",
        "distance": 20
      }
    },
    {
      "tool": "create_sketch",
      "arguments": {
        "plane": "$0"
      }
    },
    {
      "tool": "sketch_ops",
      "arguments": {
        "sketch": "$1",
        "ops": [
          {
            "op": "circle",
            "center": [
